#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    // Definición de la matriz de 6 filas x 19 columnas (114 posiciones)
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <19>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17) RC(1,18)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,17) RC(2,18)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17) RC(3,18)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17) RC(4,18)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15) RC(5,16) RC(5,17) RC(5,18)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // Mapeo de Filas en el MCP23017
        row-gpios
            = <&mcp23017 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Fila 0 -> PA5
            , <&mcp23017 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Fila 1 -> PA4
            , <&mcp23017 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Fila 2 -> PA3
            , <&mcp23017 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Fila 3 -> PA2
            , <&mcp23017 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Fila 4 -> PA1
            , <&mcp23017 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Fila 5 -> PA0
            ;

        // Mapeo Híbrido de Columnas (nRF52840 + MCP23017)
        col-gpios
            = <&pro_micro 15 GPIO_ACTIVE_HIGH> // Col 0 -> D15
            , <&pro_micro 14 GPIO_ACTIVE_HIGH> // Col 1 -> D14
            , <&pro_micro 16 GPIO_ACTIVE_HIGH> // Col 2 -> D16
            , <&pro_micro 10 GPIO_ACTIVE_HIGH> // Col 3 -> D10
            , <&pro_micro 9  GPIO_ACTIVE_HIGH> // Col 4 -> D9
            , <&pro_micro 8  GPIO_ACTIVE_HIGH> // Col 5 -> D8
            , <&pro_micro 7  GPIO_ACTIVE_HIGH> // Col 6 -> D7
            , <&pro_micro 6  GPIO_ACTIVE_HIGH> // Col 7 -> D6
            , <&pro_micro 5  GPIO_ACTIVE_HIGH> // Col 8 -> D5
            , <&mcp23017 15 GPIO_ACTIVE_HIGH>  // Col 9 -> PB7
            , <&mcp23017 14 GPIO_ACTIVE_HIGH>  // Col 10 -> PB6
            , <&mcp23017 13 GPIO_ACTIVE_HIGH>  // Col 11 -> PB5
            , <&mcp23017 12 GPIO_ACTIVE_HIGH>  // Col 12 -> PB4
            , <&mcp23017 11 GPIO_ACTIVE_HIGH>  // Col 13 -> PB3
            , <&mcp23017 10 GPIO_ACTIVE_HIGH>  // Col 14 -> PB2
            , <&mcp23017 9  GPIO_ACTIVE_HIGH>  // Col 15 -> PB1
            , <&mcp23017 8  GPIO_ACTIVE_HIGH>  // Col 16 -> PB0
            , <&mcp23017 7  GPIO_ACTIVE_HIGH>  // Col 17 -> PA7
            , <&mcp23017 6  GPIO_ACTIVE_HIGH>  // Col 18 -> PA6
            ;
    };

    // Configuración del Rotary Encoder EC11
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // D1
        b-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // D0
        resolution = <4>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
    };
};

// Configuración del Bus I2C para el expansor
&i2c0 {
    status = "okay";
    sda-pin = <3>; // SDA en D3
    scl-pin = <4>; // SCL en D4

    mcp23017: mcp23017@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;
        label = "MCP23017";
        gpio-controller;
        #gpio-cells = <2>;
        // Interrupción física conectada al pin D2
        int-gpios = <&pro_micro 2 GPIO_ACTIVE_LOW>;
    };
};